---
export enum ArrowDirection {
    LeftToRight,
    RightToLeft,
}

interface Props {
    direction: ArrowDirection;
}

const { direction } = Astro.props;

const color = "var(--primary-clr)";
---

<svg
    width={"80%"}
    height="239"
    viewBox={`0 0 792 239`}
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    preserveAspectRatio="none"
    class={direction == ArrowDirection.RightToLeft ? "reversed" : ""}
>
    <path d="M11.7883 5.99756C11.7882 230.697 780.474 5.99756 780.474 230.697" stroke={color} stroke-width="2"></path>
    <path
        d="M3.3053 6.86689L11.7882 1.2168L15.7035 4.04184L19.6187 6.86689H3.3053Z"
        fill={color}
        stroke={color}
        stroke-width="2"></path>
</svg>

<style scoped>
    svg {
        margin: 10px auto;
        width: calc(100% - min(40vw, 400px));
    }
    .reversed {
        transform: scale(-1, 1);
    }
</style>
