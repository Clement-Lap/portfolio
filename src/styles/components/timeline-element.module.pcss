.timeline {
	position: absolute;
	max-width: min(40vw, 400px);
	display: flex;
	flex-direction: column;
	gap: 0;
	height: fit-content;
	background-color: rgb(from var(--background-clr) r g b / 85%);
	backdrop-filter: blur(8px);
	transform: translate(-50%, -50%);
	padding: 10px 20px;
	outline: 7px solid var(--primary-clr);
	border-radius: var(--border-radius);
}

.timeline__title {
	margin: 0 !important;
	padding: 5px 0 !important;
}

.timeline :global(img) {
	margin: auto;
	padding: 10px auto;
}

.timeline:nth-child(2) {
	right: -27%;
	top: 34%;
}

.timeline:nth-child(3) {
	left: 15%;
	top: 46%;
}

.timeline:nth-child(4) {
	right: -27%;
	top: 60%;
}

.timeline:nth-child(5) {
	left: 10%;
	top: 70%;
}
