.footer-element {
	align-items: start;
	text-align: start;
	gap: 1em;
	color: var(--background-clr) !important;
}

.footer-element__title {
	font-weight: 500;
	color: var(--background-clr) !important;
}

.footer-element__content {
	color: var(--background-clr) !important;
	display: flex;
	flex-direction: column;
}

.footer__text,
.footer__link {
	font-size: 0.8em;
	opacity: 0.7;
}

.footer__text {
	color: var(--background-clr) !important;
}

.footer__link {
	color: var(--accent-clr);
	text-decoration: underline;
}
