.footer {
	display: grid;
	grid-template-columns: repeat(4, 1fr);
	padding: 12.5% 10%;
	gap: 3em;
	background-color: var(--primary-clr);
	width: 100%;
}

.footer__text,
.footer__link {
	font-size: 0.8em;
	opacity: 0.7;
}

.footer__text {
	color: var(--background-clr) !important;
}

.footer__link {
	color: var(--accent-clr);
	text-decoration: underline;
}

@media (width < 720px) {
	.footer {
		grid-template-columns: 1fr;
		grid-template-rows: auto;
	}
}
