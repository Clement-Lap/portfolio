:global(body) {
	position: relative;
}
:global(.cursor) {
	z-index: 100;
	background-color: #ffffff00;
	backdrop-filter: invert(100%);
	position: absolute;
	width: 70px;
	aspect-ratio: 1;
	border-radius: 100%;
	transition:
		left 0.1s ease-out,
		top 0.1s ease-out,
		width 0.3s;
	transform: translate(-50%, -50%);
	border: 1px solid #00000044;
	pointer-events: none;
	transition-duration: 0.08s;
}
