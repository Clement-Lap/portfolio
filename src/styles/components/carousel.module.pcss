.carousel > :global([data-carousel-description]) {
	font-size: 1.2em; /* the font looks smaller by default */
	font-family: var(--font-akaya) !important;
	font-weight: 400;
	user-select: none;
	height: 100%;
	text-align: center;
	width: min(400px, 45vw);
	text-wrap: wrap;
	margin: auto;
}

.carousel {
	justify-content: center;
	display: flex;
	flex-direction: column;
	gap: 1em;
}

.carousel__wrapper > :global(img) {
	border-radius: calc(var(--border-radius) * 4);
	user-select: none;
	height: auto;
	width: min(400px, 45vw);
	transition: all 0.6s;
}

.carousel__wrapper {
	position: relative;
	width: 100%;
}

@media (width > 1280px) {
	.carousel__wrapper {
		transform-origin: 0% 0%;
		height: calc(min(24vw, 340px) * 1.8);
	}

	.carousel__wrapper > :global(img) {
		position: absolute;
		user-select: none;
		pointer-events: all;
		width: min(24vw, 340px);
		height: auto;
		transition: all 0.2s;
	}

	.carousel__wrapper > :global(img:nth-child(1)) {
		z-index: 2;
	}

	.carousel__wrapper > :global(img:nth-child(2)) {
		z-index: 3;
	}

	.carousel__wrapper > :global(img:nth-child(3)) {
		z-index: 4;
	}

	.carousel__wrapper > :global(img:nth-child(4)) {
		z-index: 5;
	}

	.carousel__wrapper > :global(img:nth-child(5)) {
		z-index: 6;
	}

	.carousel__wrapper > :global(*) {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
	}

	.rewind {
		z-index: 1;
		padding: 2em 4em;
		border-radius: var(--border-radius);
		border: none;
	}
}

@media (width < 1280px) {
	.carousel {
		width: 100%;
	}

	.carousel__wrapper {
		position: relative;
		overflow: hidden;
		width: 100%;
		height: 500px;
	}

	.carousel__wrapper > :global(img) {
		height: 100%;
		width: auto;
		position: absolute;
		top: 50%;
		right: 0;
		z-index: 1;
		transform: translate(0, -50%) scale(0.5);
	}

	.carousel > :global([data-carousel-description]) {
		width: 100%;
	}

	.carousel__wrapper > .rewind {
		display: none;
	}
}
