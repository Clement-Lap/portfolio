---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import { Font } from "astro:assets";

interface Props {
    lang: string;
    title: string;
}

const { lang, title } = Astro.props;
---

<html lang={lang}>
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Clems portfolio - {title}</title>
        <Font cssVariable="--font-kufam" />
        <Font cssVariable="--font-lexend" />
    </head>
    <body>
        <Header />
        <slot />
        <Footer />
    </body>
</html>

<style is:global>
    * {
        box-sizing: border-box;
    }

    a {
        text-decoration: none;
    }

    :root {
        --accent-clr: #a4d5eb;
        --primary-clr: #35383a;
        --primary-clr-2: #4d5153;
        --secondary-clr: #d2d2d2;
        --background-clr: #ffffff;
    }

    h1,
    h1.normal {
        font-size: 48px;
        font-weight: bold;
        letter-spacing: -3%;
        font-family: var(--font-kufam);
        color: var(--primary-clr);
    }

    h3,
    h2,
    h3.normal {
        font-size: 36px;
        font-family: var(--font-lexend);
        color: var(--primary-clr-2);
    }

    h6,
    h6.normal {
        font-family: var(--font-lexend);
        font-size: 24px;
    }

    h1.highlighted {
        color: var(--accent-clr);
        font-size: 54px;
        font-weight: bold;
        letter-spacing: -2%;
    }

    h2.bold,
    h3.bold {
        font-weight: 500;
        color: var(--primary-clr);
    }

    h3.highlighted {
        font-family: var(--font-kufam);
        font-weight: 600;
        color: var(--accent-clr);
    }

    h6.bold {
        font-weight: 500;
    }

    p,
    p.normal {
        font-family: var(--font-lexend);
        font-size: 18px;
        color: var(--primary-clr);
    }

    .underlined {
        position: relative !important;
    }

    .underlined::after {
        position: absolute;
        content: "........................";
        font-size: 48px;
        left: -5px;
        bottom: -15px;
        color: var(--accent-clr);
        overflow-x: hidden;
        width: calc(100% + 10px);
    }
</style>
