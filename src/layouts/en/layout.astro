---
import Header from "@components/header.astro";
import Footer from "@components/footer.astro";
import Cursor from "@components/cursor.astro";
import FooterParts from "@components/footer-parts.astro";
import { Font } from "astro:assets";
import "@styles/styles.pcss";

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<head>
	<meta lang="en" charset="utf-8" />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<title>Clems portfolio - {title}</title>
	<Font cssVariable="--font-kufam" />
	<Font cssVariable="--font-lexend" />
	<Font cssVariable="--font-akaya" />
</head>
<body>
	<Cursor />
	<Header />
	<slot />
	<Footer>
		<FooterParts title="Copyright" descriptions={["© 2026 LAPORTE Clément.", "All rights reserved."]} />
		<FooterParts
			title="Website"
			descriptions={[
				"The whole website, code, design, pictures and images (except the weather icons, from the API) are handmade by me. Nothing was generated by AI or any kind of LLM.",
			]}
			links={[
				{ href: `/sitemap-0.xml`, text: "Sitemap" },
				{ href: "https://codeberg.org/clems-lap/portfolio", text: "Codeberg repository" },
				{ href: "https://github.com/Clement-Lap/portfolio", text: "Github mirror" },
			]}
		/>
		<FooterParts title="External content" links={[{ href: "https://www.weatherapi.com/", text: "Weather API" }]} />
		<FooterParts
			title="Links"
			links={[
				{ href: "https://codeberg.org/clems-lap", text: "My Codeberg profile" },
				{ href: "https://github.com/Clement-Lap", text: "My Github profile" },
				{ href: "https://www.linkedin.com/clement-lap", text: "My Linkedin profile" },
			]}
		/>
	</Footer>
</body>
