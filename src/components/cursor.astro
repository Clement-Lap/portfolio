<div id="mouse"></div>

<script>
    import { gsap } from "gsap";

    const defaultSize = 70;
    const treshold = 180;

    document.addEventListener("mousemove", (event) => {
        const left = Math.max(defaultSize / 2, Math.min(document.body.clientWidth - defaultSize / 2, event.pageX));
        gsap.to("#mouse", {
            top: event.pageY,
            left: left,
            duration: 0.1,
        });
    });
</script>

<style>
    body {
        position: relative;
    }
    #mouse {
        z-index: 100;
        background-color: #ffffff00;
        backdrop-filter: invert(100%);
        position: absolute;
        width: 70px;
        aspect-ratio: 1;
        border-radius: 100%;
        transition:
            left 0.1s ease-out,
            top 0.1s ease-out,
            width 0.3s;
        transform: translate(-50%, -50%);
        border: 1px solid #00000044;
        pointer-events: none;
    }
</style>
