---
import styles from "#styles/components/header.module.pcss";

import UKFlag from "#images/flags/Flag_of_the_United_Kingdom.svg";
import FranceFlag from "#images/flags/Flag_of_France.svg";
import Arrow from "#images/other/scroll-down-arrow.astro";
---

<header class={styles.header}>
	<div class={styles["france-data"]}>
		<code>Time</code>
		<code>Weather</code>
	</div>
	<div class={styles.links}>
		<a href={"/en/"} class={styles["links__link"]} data-header-link>Home</a>
		<a href={"/en/about"} class={styles["links__link"]} data-header-link>About</a>
		<a href={"/en/projects"} class={styles["links__link"]} data-header-link>Projects</a>
		<a href={"/en/blog"} class={styles["links__link"]} data-header-link>Blog</a>
	</div>
	<div class={styles.interactions} id="interactions">
		<select class={styles.language} id="language">
			<option value="en">English</option>
			<option value="fr">Français</option>
		</select>
		<select class={styles.theme} id="theme">
			<option>Default</option>
			<option>Dark</option>
			<option>Coffee</option>
			<option>Beach</option>
		</select>
	</div>
</header>
