---
import { Image } from "astro:assets";
import { type ISkillImage } from "@utils/skill-card-imports.ts";

export interface Props {
	title: string;
	description: string;
	images: ISkillImage[];
	direction: Direction;
}

export enum Direction {
	vertical = "vertical",
	horizontal = "horizontal",
}

const { title, description, images, direction = "vertical" } = Astro.props;
---

<div class={`skill-card ${direction}`}>
	<div class="text-section">
		<h3 class="highlighted title">{title}</h3>
		<p class="description">{description}</p>
	</div>
	<div class="image-section">
		{
			images
				.sort((img1, img2) => (img1.highlight === img2.highlight ? 0 : img1.highlight ? -1 : 1))
				// https://www.geeksforgeeks.org/javascript/sort-an-array-of-objects-using-boolean-property-in-javascript/
				.map((img) => (
					<Image
						src={img.import}
						class={img.highlight ? "language-logo highlighted-logo" : "language-logo"}
						width={128}
						height={128}
						alt={img.alt}
					/>
				))
		}
	</div>
</div>

<style>
	.skill-card {
		display: flex;
		padding: 16px;
		gap: 20px;
		border: 1px solid var(--accent-clr);
		border-radius: var(--border-radius);
		height: fit-content;
		width: 100%;
	}

	.horizontal {
		flex-direction: row;
	}

	.vertical {
		flex-direction: column;
	}

	.skill-card > .text-section > .title,
	.skill-card > .text-section > .description {
		padding: 0;
		margin: 0;
	}

	.skill-card > .image-section {
		display: flex;
		flex-wrap: wrap;
		height: fit-content;
		gap: 6px;
	}

	.skill-card:nth-child(1) {
		grid-area: frontend;
	}

	.skill-card:nth-child(2) {
		grid-area: backend;
	}

	.skill-card:nth-child(3) {
		grid-area: software;
	}

	.skill-card:nth-child(4) {
		grid-area: tools;
	}

	.skill-card > .image-section > img {
		padding: 6px;
		flex: 1 1 0%;
		min-width: 51px;
		max-width: 64px;
		object-fit: cover;
		height: auto;
		aspect-ratio: 1;
		border-radius: var(--border-radius);
	}

	.highlighted-logo {
		background-color: var(--accent-clr);
	}

	@media (max-width: 1280px) {
		.horizontal {
			flex-direction: column;
		}
	}

	@media (620px < width < 740px) {
		.horizontal {
			flex-direction: row;
		}

		.vertical {
			flex-direction: row;
		}
	}
</style>
