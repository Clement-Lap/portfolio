---
import styles from "@styles/components/skill-cards.module.pcss";
import { Image } from "astro:assets";
import { type ISkillImage } from "@utils/skill-card-imports.ts";

export interface Props {
	title: string;
	description: string;
	images: ISkillImage[];
	direction: Direction;
}

export enum Direction {
	vertical = "vertical",
	horizontal = "horizontal",
}

const { title, description, images, direction = "vertical" } = Astro.props;
---

<div class={`${styles["skill-card"]} ${styles[direction]}`}>
	<div class={styles["skill-card__text"]}>
		<h3 class={`highlighted ${styles["skill-card__title"]}`}>{title}</h3>
		<p class={styles["skill-card__description"]}>{description}</p>
	</div>
	<div class={styles["skill-card__images"]}>
		{
			images
				.sort((img1, img2) => (img1.highlight === img2.highlight ? 0 : img1.highlight ? -1 : 1))
				// https://www.geeksforgeeks.org/javascript/sort-an-array-of-objects-using-boolean-property-in-javascript/
				.map((img) => (
					<Image
						src={img.import}
						class={img.highlight ? `${styles["language-logo"]} ${styles["highlighted-logo"]}` : styles["language-logo"]}
						width={128}
						height={128}
						alt={img.alt}
					/>
				))
		}
	</div>
</div>
