---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<div class="footer-element">
    <div class="footer-element--title">
        <h6 class="bold">{title}</h6>
    </div>
    <div class="footer-element--content">
        <slot />
    </div>
</div>

<style>
    .footer-element {
        align-items: start;
        text-align: start;
        gap: 1em;
        color: var(--background-clr) !important;
    }

    .bold {
        color: var(--background-clr) !important;
    }

    .footer-element,
    .footer-element--content {
        color: var(--background-clr) !important;
        display: flex;
        color: var(--background-clr) !important;
        flex-direction: column;
    }
</style>
