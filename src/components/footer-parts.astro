---
interface Props {
	title: string;
	descriptions?: string[];
	links?: {
		href: string;
		text: string;
	}[];
}

const { title, descriptions, links } = Astro.props;
---

<div class="footer-element">
	<h6 class="footer-element__title">{title}</h6>
	<div class="footer-element__content">
		{descriptions?.map((description) => (
			<p class="footer__text">{description}</p>
		))}
		{links?.map((link) => (
			<a class="footer__link" target="_blank" rel="noopener noreferrer" href={link.href}>
				{link.text}
			</a>
		))}
	</div>
</div>

<style>
	.footer-element {
		display: flex;
		flex-direction: column;
		align-items: start;
		text-align: start;
		gap: 0.33lh;
		color: var(--background-clr) !important;
	}

	.footer-element__title {
		font-weight: 500;
		color: var(--background-clr) !important;
	}

	.footer-element__content {
		color: var(--background-clr) !important;
		display: flex;
		flex-direction: column;
	}

	.footer__text,
	.footer__link {
		font-size: 0.8em;
		opacity: 0.7;
	}

	.footer__text {
		color: var(--background-clr) !important;
	}

	.footer__link {
		color: var(--accent-clr);
		text-decoration: underline;
	}
</style>
