---
import styles from "@styles/components/footer-parts.module.pcss";

interface Props {
	title: string;
	descriptions?: string[];
	links?: {
		href: string;
		text: string;
	}[];
}

const { title, descriptions, links } = Astro.props;
---

<div class={styles["footer-element"]}>
	<h6 class={styles["footer-element__title"]}>{title}</h6>
	<div class={styles["footer-element__content"]}>
		{descriptions?.map((description) => <p class={styles["footer__text"]}>{description}</p>)}
		{
			links?.map((link) => (
				<a class={styles["footer__link"]} target="_blank" rel="noopener noreferrer" href={link.href}>
					{link.text}
				</a>
			))
		}
	</div>
</div>
