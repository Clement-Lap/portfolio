---
import { Image } from "astro:assets";
import AngryClem from "../images/clem/angry-clem.png";
import ClemNCat from "../images/clem/clem-n-cat.png";
import DumbCat from "../images/clem/dumb-cat.png";
import EvilCat from "../images/clem/evil-cat.png";
import GloriousCat from "../images/clem/glorious-cat.png";
---

<div>
    <Image src={AngryClem} alt="Little me, angry me." />
    <Image src={ClemNCat} alt="Me holding a long cat." />
    <Image src={DumbCat} alt="My dumb cat." />
    <Image src={EvilCat} alt="My evil cat." />
    <Image src={GloriousCat} alt="She looks like Batman." />
</div>

<style>
    div {
        position: relative;
        width: 100%;
        height: 100%;
        transform-origin: 0% 0%;
    }

    div > img {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 380px;
        height: auto;
    }

    div > img:nth-child(1) {
        transform: translate(-50%, -50%) rotate(10deg);
    }

    div > img:nth-child(2) {
        transform: translate(-49%, -53%) rotate(-3deg);
    }

    div > img:nth-child(3) {
        transform: translate(-52%, -46%);
    }

    div > img:nth-child(4) {
        transform: translate(-50%, -50%) rotate(6deg);
    }

    div > img:nth-child(5) {
        transform: translate(-50%, -51%) rotate(-1deg);
    }
</style>
