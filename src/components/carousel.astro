---
import { Image } from "astro:assets";
import AngryClem from "../images/clem/angry-clem.png";
import ClemNCat from "../images/clem/clem-n-cat.png";
import DumbCat from "../images/clem/dumb-cat.png";
import EvilCat from "../images/clem/evil-cat.png";
import GloriousCat from "../images/clem/glorious-cat.png";
---

<div id="carousel">
    <Image
        src={AngryClem}
        id="img-1"
        alt="Little me but angry"
        draggable="false"
        width={400}
        data-description='I was at the beach with my family doing a "sandball" fight, when my brother hid a rock inside the ball (it hurt).'
    />
    <Image
        src={ClemNCat}
        id="img-2"
        alt="Me holding a long cat"
        draggable="false"
        width={400}
        data-description="Me and my former cat, Helis (Norwegian Forest cat breed)."
    />
    <Image
        src={DumbCat}
        id="img-3"
        alt="My dumb cat"
        draggable="false"
        width={400}
        data-description="My other cat, called Gazor-pazor-field, a reference to Rick and Morty (he's very fat and dumb)."
    />
    <Image
        src={EvilCat}
        id="img-4"
        alt="My evil cat"
        draggable="false"
        width={400}
        data-description='My current cat, called Plume (French for "feather") because she is tiny and lightweight.'
    />
    <Image
        src={GloriousCat}
        id="img-5"
        alt="My cat looking like Batman"
        draggable="false"
        width={400}
        data-description="She likes to go on my window to fight the crime in her city (watch for birds in the garden)."
    />
    <button id="rewind">Rewind</button>
    <p id="img-description"></p>
</div>

<script>
    import { gsap } from "gsap";

    type InteractionEvent = MouseEvent | TouchEvent;

    const CarouselSwapEvent = new Event("carouselswap");

    class Carousel {
        /*
      readonly button = document.getElementById("rewind")!;
      readonly imgContent = document.getElementById("img-content")!;
      readonly animationTime = 0.5;
      readonly deltaTreshold = 300; // how far the image has to move from its original position
      readonly currentImageElement = document.getElementById("img-5")!;
      */
        readonly buttonElement: HTMLElement;
        readonly imageDescriptionElement: HTMLElement;
        readonly animationTime: number;
        readonly deltaTreshold: number; // how far the image has to move from its original position

        currentImageElement: HTMLElement;
        currentImage: number;
        isDragged: boolean;
        defaultOffsetX: number;
        defaultOffsetY: number;

        constructor(animationTime: number, deltaTreshold: number) {
            this.buttonElement = document.getElementById("rewind")!;
            this.currentImageElement = document.getElementById("img-5")!;
            this.imageDescriptionElement = document.getElementById("img-description")!;

            this.animationTime = animationTime;
            this.deltaTreshold = deltaTreshold;

            this.currentImage = 5;
            this.defaultOffsetX = 0;
            this.defaultOffsetY = 0;
            this.isDragged = false;
        }

        private setNextImage() {
            this.currentImage--;
            if (this.currentImage < 1) this.currentImage = 1;
            if (this.currentImage > 5) this.currentImage = 5; // should never happen
            this.currentImageElement = document.getElementById(`img-${this.currentImage}`)!; // update the current image
            this.setImgEvents();
            this.setImageDescription();
        }

        private moveEventPos(event: InteractionEvent): [number, number] {
            let clientX = 0;
            let clientY = 0;

            if (event instanceof MouseEvent) {
                clientX = event.pageX;
                clientY = event.pageY;
            } else if (event instanceof TouchEvent) {
                clientX = event.touches[0].pageX;
                clientY = event.touches[0].pageY;
            }

            return [clientX, clientY];
        }

        private setImageDescription() {
            this.imageDescriptionElement.innerHTML = this.currentImageElement.getAttribute("data-description") || "";
        }

        private resetImage() {
            this.isDragged = false;
            gsap.to(`#img-${this.currentImage}`, {
                x: 0,
                y: 0,
                duration: this.animationTime * 1.5,
            });

            this.currentImageElement.removeEventListener("mousemove", (event: MouseEvent) => this.moveImg(event));
            this.currentImageElement.removeEventListener("touchmove", (event: TouchEvent) => this.moveImg(event));
            this.currentImageElement.removeEventListener("mouseup", () => this.resetImage());
            this.currentImageElement.removeEventListener("touchend", () => this.resetImage());
        }

        private reloadDefault() {
            for (let i = 1; i <= 5; i++) {
                gsap.to(`#img-${i}`, {
                    pointerEvents: "all",
                    x: 0,
                    y: 0,
                    opacity: 1,
                    delay: 0.15 * (i - 1),
                });
            }

            this.currentImage = 5;
            this.currentImageElement = document.getElementById("img-5")!;
            this.setImageDescription();
        }

        private selectImg(event: InteractionEvent) {
            this.isDragged = true;

            this.saveOffset(event);

            this.currentImageElement.addEventListener("mousemove", (event: MouseEvent) => this.moveImg(event));
            this.currentImageElement.addEventListener("touchmove", (event: TouchEvent) => this.moveImg(event));
            this.currentImageElement.addEventListener("mouseup", () => this.resetImage());
            this.currentImageElement.addEventListener("touchend", () => this.resetImage());
        }

        private saveOffset(event: InteractionEvent) {
            const [clientX, clientY] = this.moveEventPos(event);
            this.defaultOffsetX = clientX;
            this.defaultOffsetY = clientY;
        }

        private moveImg(event: InteractionEvent) {
            if (!this.isDragged) return;
            event.preventDefault();
            const [clientX, clientY] = this.moveEventPos(event);

            const newX = clientX - this.defaultOffsetX;
            const newY = clientY - this.defaultOffsetY;
            const delta = Math.abs(newX) + Math.abs(newY); // should've been `sqrt(newX² + newY²)` for precision, but overkill
            gsap.to(`#img-${this.currentImage}`, {
                x: newX,
                y: newY,
                duration: this.animationTime,
            });

            if (delta > this.deltaTreshold) document.dispatchEvent(CarouselSwapEvent);
        }

        private swapImage() {
            this.isDragged = false;

            // remove previous events
            this.currentImageElement.removeEventListener("mouseup", this.resetImage);
            this.currentImageElement.removeEventListener("mousemove", this.moveImg);
            this.currentImageElement.removeEventListener("mousedown", this.selectImg);

            // remove the image visually and interactively
            gsap.to(`#img-${this.currentImage}`, {
                opacity: 0,
                pointerEvents: "none",
                duration: this.animationTime,
                overwrite: true,
            });

            // self explanatory
            this.setNextImage();
            this.setImageDescription();
        }

        private setImgEvents() {
            this.currentImageElement.addEventListener("mousedown", (event: InteractionEvent) => this.selectImg(event));
            this.currentImageElement.addEventListener("touchstart", (event: InteractionEvent) => this.selectImg(event));
        }

        private startAnimation() {
            gsap.to("#img-1", {
                x: 5,
                y: -2,
                rotate: 6,
                duration: this.animationTime,
            });
            gsap.to("#img-2", {
                x: -5,
                rotate: -12,
                duration: this.animationTime,
            });
            gsap.to("#img-3", {
                x: 2,
                y: 2,
                rotate: 9,
                duration: this.animationTime,
            });
            gsap.to("#img-5", {
                x: 1,
                y: -2,
                rotate: 3,
                duration: this.animationTime,
            });
        }

        public initEvents() {
            this.currentImageElement.addEventListener("mousedown", (event: InteractionEvent) => this.selectImg(event));
            this.currentImageElement.addEventListener("touchstart", (event: InteractionEvent) => this.selectImg(event));
            document.addEventListener("carouselswap", () => this.swapImage());
            this.buttonElement.onclick = () => this.reloadDefault();
        }
        public setup() {
            this.startAnimation();
            this.initEvents();
            this.setImageDescription();
        }
    }

    const carousel = new Carousel(0.3, 350);
    carousel.setup();
</script>

<style>
    #carousel {
        position: relative;
        width: 100%;
        height: 100%;
        transform-origin: 0% 0%;
        display: flex;
        flex-direction: column;
    }

    div > img {
        user-select: none;
        pointer-events: all;
        width: 340px;
        height: auto;
        border-radius: calc(var(--border-radius) * 4);
    }

    div > img:nth-child(1) {
        z-index: 2;
    }

    div > img:nth-child(2) {
        z-index: 3;
    }

    div > img:nth-child(3) {
        z-index: 4;
    }

    div > img:nth-child(4) {
        z-index: 5;
    }

    div > img:nth-child(5) {
        z-index: 6;
    }

    div > * {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
    }

    button {
        z-index: 1;
        padding: 2ch 4ch;
        border-radius: var(--border-radius);
        border: none;
    }

    p {
        font-size: 1.2em; /* the font looks smaller by default */
        top: 100% !important;
        font-family: var(--font-akaya) !important;
        font-weight: 400;
        user-select: none;
    }
</style>
