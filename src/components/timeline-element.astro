---
interface Props {
	title: string;
	description: string[];
}

const { title, description } = Astro.props;
---

<div class="timeline-element">
	<h3 class="highlighted timeline-element__title" }>
		{title}
	</h3>
	<ul>
		{description.map((element: string) => (
			<li>{element}</li>
		))}
	</ul>
</div>
<style>
	.timeline-element {
		position: absolute;
		max-width: min(40vw, 400px);
		display: flex;
		flex-direction: column;
		gap: 0;
		margin: 0;
		height: fit-content;
		background-color: rgb(from var(--background-clr) r g b / 85%);
		backdrop-filter: blur(8px);
		/*
		transform: translate(-50%, -50%);
		*/
		padding: 10px 20px;
		outline: 7px solid var(--primary-clr);
		border-radius: var(--border-radius);
	}

	.timeline-element__title {
		margin: 0 !important;
		padding: 5px 0 !important;
	}

	@media screen and (--s-device) {
		.timeline-element {
			position: static;
			outline: none;
			width: 100%;
			max-width: 100%;
			padding: 0;
		}
	}
</style>
