---
interface Props {
	title: string;
	description: string[];
	x: string;
	y: string;
}

function formatX(str: string) {
	let result: string;
	if (str.startsWith("-")) {
		result = `right: ${str.slice(1)}`;
	} else {
		result = `left: ${str}`;
	}

	return result;
}

function formatY(str: string) {
	let result: string;
	if (str.startsWith("-")) {
		result = `bottom: ${str.slice(1)}`;
	} else {
		result = `top: ${str}`;
	}

	return result;
}

const { title, description, x, y } = Astro.props;

const newX = formatX(x);
const newY = formatY(y);
---

<div class="timeline-element" style=`${newX}; ${newY}`>
	<h6 class="highlighted timeline-element__title">{title}</h6>
	<ul>
		{description.map((element: string) => (
			<li>{element}</li>
		))}
	</ul>
</div>

<script>
	const timelineElements = document.querySelectorAll("div.timeline-element");

	function toggleActive(element: HTMLElement) {
		const isActive = element.classList.contains("active");
		if (isActive) {
			const className = element.className;
			element.className = className.replace("active", "");
		} else {
			element.className += " active";
		}
	}

	timelineElements.forEach((element) => {
		element.addEventListener("pointerdown", () => {
			toggleActive(element as HTMLElement);
			console.log("tung ");
		});
	});
</script>

<style>
	.timeline-element {
		position: absolute;
		max-width: min(40vw, 400px);
		display: flex;
		flex-direction: column;
		gap: 0;
		margin: 0;
		height: fit-content;
		background-color: rgb(from var(--background-clr) r g b / 85%);
		backdrop-filter: blur(8px);
		padding: 10px 20px;
		outline: 7px solid var(--primary-clr);
		border-radius: var(--border-radius);
	}

	h6.timeline-element__title {
		margin: 0;
		padding: 5px 0;
	}

	@media screen and (--s-device), screen and (--m-device) {
		.timeline-element > ul {
			display: none;
		}

		.timeline-element {
			padding: 5px 10px;
			width: 80%;
			outline: 3px solid var(--primary-clr);
			/*transition: all 0.2s ease-in-out;*/
		}

		.timeline-element.active > ul {
			display: block;
		}

		.timeline-element.active {
			right: 0;
			left: 0;
			max-width: 100%;
			width: 100%;
			height: max-content;
			z-index: 10;
			padding: 10px 10px;
		}

		.timeline-element > h6.timeline-element__title {
			text-align: center;
		}
	}
</style>
